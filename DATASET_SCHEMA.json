{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentDiagnosticsObservatorySchema",
  "description": "Validation schema for agent trial execution signals and telemetry records",
  "type": "object",
  "required": [
    "task_id",
    "model",
    "agent_name",
    "benchmark",
    "passed",
    "total_turns",
    "tool_calls_total",
    "error_count",
    "retry_count",
    "duration_seconds",
    "tool_call_sequence",
    "trial_id"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "model": { "type": "string" },
    "agent_name": { "type": "string" },
    "config_name": { "type": "string" },
    "benchmark": { "type": "string" },
    "reward": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
    "passed": { "type": "boolean" },
    "has_verifier_result": { "type": "boolean" },
    "total_turns": { "type": "integer", "minimum": 0 },
    "tool_calls_total": { "type": "integer", "minimum": 0 },
    "search_tool_calls": { "type": "integer", "minimum": 0 },
    "edit_tool_calls": { "type": "integer", "minimum": 0 },
    "code_nav_tool_calls": { "type": "integer", "minimum": 0 },
    "semantic_search_tool_calls": { "type": "integer", "minimum": 0 },
    "unique_files_read": { "type": "integer", "minimum": 0 },
    "unique_files_edited": { "type": "integer", "minimum": 0 },
    "files_read_list": { "type": "array", "items": { "type": "string" } },
    "files_edited_list": { "type": "array", "items": { "type": "string" } },
    "error_count": { "type": "integer", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "trajectory_length": { "type": "integer", "minimum": 0 },
    "has_result_json": { "type": "boolean" },
    "has_trajectory": { "type": "boolean" },
    "duration_seconds": { "type": "number", "minimum": 0.0 },
    "rate_limited": { "type": "boolean" },
    "exception_crashed": { "type": "boolean" },
    "patch_size_lines": { "type": "integer", "minimum": 0 },
    "tool_call_sequence": { "type": "array", "items": { "type": "string" } },
    "benchmark_source": { "type": "string" },
    "trial_path": { "type": "string" },
    "trial_id": { "type": "string" },
    "trial_id_full": { "type": "string" }
  }
}
